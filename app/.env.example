# SERVER
PORT=3001
NODE_ENV=development
APP_MODE=development
VITE_APP_MODE=development

# DATABASE
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_snpc
DB_USER=postgres
DB_PASS=postgres
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/db_snpc

# SECURITY
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# CORS / FRONTEND
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api

# EMAIL (optional locally)
ENABLE_EMAIL=false
USE_SENDGRID=false

# Optional SaaS gates
SUBSCRIPTION_GATE_ENABLED=false
