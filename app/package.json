{
  "name": "snpc-app",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter snpc-frontend dev",
    "dev:backend": "pnpm --filter snpc-backend dev",
    "build": "pnpm --filter snpc-frontend build && pnpm --filter snpc-backend build",
    "build:frontend": "pnpm --filter snpc-frontend build",
    "build:backend": "pnpm --filter snpc-backend build",
    "start": "pnpm --filter snpc-backend start",
    "start:backend": "pnpm --filter snpc-backend start",
    "db:generate": "pnpm --filter snpc-backend db:generate",
    "db:migrate": "pnpm --filter snpc-backend db:migrate",
    "db:studio": "pnpm --filter snpc-backend db:studio",
    "test": "pnpm --filter snpc-backend test",
    "test:unit": "pnpm --filter snpc-backend test:unit",
    "test:integration": "pnpm --filter snpc-backend test:integration",
    "install:all": "pnpm install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
