# SERVER CONFIG
PORT=3001
NODE_ENV=production
APP_MODE=production
VITE_APP_MODE=production

# DATABASE CONNECTION (Usar credenciales REALES de producción)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=db_snpc
DB_USER=usuario_prod
DB_PASS=contraseña_segura_prod
DB_DIALECT=postgres
DATABASE_URL=postgresql://usuario_prod:contraseña_segura_prod@127.0.0.1:5432/db_snpc

# SECURITY (JWT) - ¡CAMBIAR ESTO POR UNA CLAVE LARGA Y ÚNICA!
JWT_SECRET=a_very_long_random_string_that_is_secure_and_unique
JWT_EXPIRES_IN=24h

# CORS - Dominio donde estará el frontend
CLIENT_URL=https://cuidados.example.gob.mx

# API URL for Frontend - Dominio donde estará el backend/api
VITE_API_URL=https://cuidados.example.gob.mx/api

# EMAIL CONFIG (SendGrid)
ENABLE_EMAIL=true
USE_SENDGRID=true
SENDGRID_API_KEY=SG.TuApiKeyDeSendgridReal
SENDGRID_FROM_EMAIL=noreply@cuidados.example.gob.mx

# AI KEYS (opcional)
GEMINI_API_KEY=
GEMINI_CONCIERGE_MODEL=gemini-2.5-flash-lite

# Stripe SaaS + Connect (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_COUNTRY=MX
SUBSCRIPTION_GATE_ENABLED=false
STRIPE_TEST_CHECKOUT_AMOUNT_CENTS=
